[node name="StatusLabel" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="Panel/SoloButton" to="." method="_on_solo_pressed"]
[connection signal="pressed" from="Panel/ConnectButton" to="." method="_on_connect_pressed"]