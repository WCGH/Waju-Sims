[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/dmu/multiplayer/dmu_session_menu.gd" id="1"]

[node name="DmuSessionMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 0
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -145.0
offset_right = 180.0
offset_bottom = 145.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel"]
layout_mode = 2
text = "DMU Session"
horizontal_alignment = 1

[node name="SoloButton" type="Button" parent="Panel"]
layout_mode = 2
text = "Solo"

[node name="Divider" type="HSeparator" parent="Panel"]
layout_mode = 2

[node name="AddressInput" type="LineEdit" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Server address"
text = "127.0.0.1"

[node name="PortInput" type="SpinBox" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1.0
max_value = 65535.0
value = 7000.0

[node name="PasswordInput" type="LineEdit" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Server password (optional)"
